<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LeptonPackageVersion Condition="'$(BUILD_VERSION)' == ''">1.0.0</LeptonPackageVersion>
    <LeptonPackageVersion Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</LeptonPackageVersion>
    <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)../../artifacts;$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Soenneker.Lepton.Suite" Version="$(LeptonPackageVersion)" />
    <ProjectReference Include="../Soenneker.Lepton.Suite.PackageSmoke.Dependency/Soenneker.Lepton.Suite.PackageSmoke.Dependency.csproj" />
  </ItemGroup>
</Project>
